{
  "name": "multimine",
  "version": "0.1.0",
  "description": "Multi-agent workstation: a team of AI agents around a Mastermind, drawn in space.",
  "main": "./out/main/index.js",
  "author": "Efkrdnz",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.108",
    "@ai-sdk/google": "^2.0.101",
    "@ai-sdk/groq": "^2.0.57",
    "@ai-sdk/openai": "^2.0.133",
    "@ai-sdk/openai-compatible": "^1.0.58",
    "@ai-sdk/xai": "^2.0.99",
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ai": "^5.0.271",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.26"
  },
  "devDependencies": {
    "@google/model-viewer": "^4.3.1",
    "@playwright/test": "1.56",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.49.0",
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.efkrdnz.multimine",
    "productName": "Multimine",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "templates/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/**",
      "templates/**"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
